; render2d.v.pica — PICA200 vertex shader for UV-mapped 2D quads
;
; Assembled by: picasso shaders/render2d.v.pica -o build/render2d.shbin
;   (scripts/build_3ds.sh runs this automatically when the file is present)
;
; Input register layout — must match AttrInfo_AddLoader order in citro3d_backend.nim:
;   v0  position    vec4  (x, y, z=0, w=1) — GPU_FLOAT, 4 components
;   v1  UV          vec2  (u, v; z/w padded to 0/1 by GPU) — GPU_FLOAT, 2 components
;   v2  color       vec4  (r, g, b, a) — GPU_UNSIGNED_BYTE, 4 components
;
; Color normalization: GPU_UNSIGNED_BYTE is NOT normalized by the PICA200.
; The GPU loads u8 [0,255] as the raw float (e.g., 255 → 255.0).
; We multiply by 1/255 in the shader to convert to [0,1] before output.
; Evidence: loop_subdivision citro3d example passes valence as GPU_UNSIGNED_BYTE
; and the geometry shader treats the value as a raw integer (6 → 6.0), not 0.024.
;
; Output semantic contract — fragment stage reads these in order:
;   result.position   → outpos   clip-space position
;   result.texcoord0  → outtc0   UV for sampler2D atlas
;   result.color      → outclr   per-vertex tint (MODULATE with texel in TEV)

; Uniforms
.fvec projection[4]

; Constants
.constf inv255(0.00392157, 0.00392157, 0.00392157, 0.00392157) ; 1/255

; Inputs
.alias inpos v0
.alias intc0 v1
.alias inclr v2

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

.proc main
    ; outpos = projection * inpos
    ; inpos is already (x, y, 0, 1) — no need to force w
    dp4 outpos.x, projection[0], inpos
    dp4 outpos.y, projection[1], inpos
    dp4 outpos.z, projection[2], inpos
    dp4 outpos.w, projection[3], inpos

    ; Pass UV through (v1.xy are u,v; z/w GPU-padded)
    mov outtc0.xy, intc0.xy

    ; Normalize color from [0,255] to [0,1]
    ; inv255 can't be used as src2 of mul directly — load into temp first
    mov r0, inv255
    mul outclr, inclr, r0

    end
.end
